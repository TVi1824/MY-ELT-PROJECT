        "query": "INSERT INTO dw.fact_sales (transaction_id, date_key, customer_id, product_id, quantity)\nSELECT DISTINCT ON (s.transaction_id)\n    s.transaction_id,\n    TO_CHAR(s.transaction_date, 'YYYYMMDD')::INT AS date_key,\n    s.customer_id,\n    s.product_id,\n    s.quantity\nFROM staging.sales s\nORDER BY s.transaction_id, s.transaction_date DESC\nON CONFLICT (transaction_id) \nDO UPDATE SET \n    quantity = EXCLUDED.quantity,\n    date_key = EXCLUDED.date_key;",
