    {
      "parameters": {
        "jsCode": "// Lấy số lượng dòng bị NULL từ node Postgres trước đó\nconst null_count = $input.first().json.null_count;\n\n// Ngưỡng chấp nhận rác (ví dụ tối đa 5 dòng rác)\nconst threshold = 5;\n\nif (null_count > threshold) {\n    // Nếu quá nhiều rác, tung lỗi để ngắt hệ thống\n    throw new Error(`Dữ liệu rác quá nhiều (${null_count} dòng NULL). Vui lòng kiểm tra lại file nguồn!`);\n}\n\n// Nếu lượng rác trong mức cho phép, cho dữ liệu đi tiếp\nreturn $input.all();"
      },
