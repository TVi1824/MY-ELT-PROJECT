        "query": "SELECT COUNT(*) as orphan_count\nFROM staging.sales s\nLEFT JOIN dw.dim_customer c ON s.customer_id = c.customer_id\nLEFT JOIN dw.dim_product p ON s.product_id = p.product_id\nWHERE c.customer_id IS NULL OR p.product_id IS NULL;",
